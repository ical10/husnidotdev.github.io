---
import type { Post } from '../lib/posts';
import { postPath } from '../lib/posts';
interface Props { prev?: Post; next?: Post; }
const { prev, next } = Astro.props;
---
{(prev || next) && (
  <nav class="post-nav" aria-label="Post navigation">
    <div class="cell">
      {next && (
        <a href={postPath(next)}>
          <span class="label">← Newer</span>
          <span class="title">{next.data.title}</span>
        </a>
      )}
    </div>
    <div class="cell right">
      {prev && (
        <a href={postPath(prev)}>
          <span class="label">Older →</span>
          <span class="title">{prev.data.title}</span>
        </a>
      )}
    </div>
  </nav>
)}

<style>
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    font-family: var(--font-sans);
  }
  .cell { min-width: 0; }
  .cell.right { text-align: right; }
  .cell a {
    display: block;
    color: var(--text);
    text-decoration: none;
    transition: color var(--transition);
  }
  .cell a:hover { color: var(--accent); }
  .label {
    display: block;
    font-size: var(--fs-tiny);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.3em;
  }
  .title { font-weight: 500; }
  @media (max-width: 540px) {
    .post-nav { grid-template-columns: 1fr; }
    .cell.right { text-align: left; }
  }
</style>
