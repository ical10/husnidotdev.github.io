---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---
{items.length > 2 && (
  <aside class="toc" aria-label="Table of contents">
    <details class="toc-mobile" open={false}>
      <summary>On this page</summary>
      <ol>
        {items.map((h) => (
          <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </details>
    <nav class="toc-desktop">
      <p class="toc-title">On this page</p>
      <ol>
        {items.map((h) => (
          <li class={`d${h.depth}`}><a href={`#${h.slug}`} data-toc-link>{h.text}</a></li>
        ))}
      </ol>
    </nav>
  </aside>
)}

<style>
  .toc {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
  }
  .toc ol { list-style: none; padding: 0; margin: 0; }
  .toc li { margin: 0.4em 0; line-height: 1.4; }
  .toc li.d3 { padding-left: 1em; font-size: 0.85em; }
  .toc a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition);
    border-left: 2px solid transparent;
    padding-left: 0.6em;
    display: block;
  }
  .toc a:hover { color: var(--text); }
  .toc a.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }
  .toc-title {
    font-size: var(--fs-tiny);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
    margin: 0 0 0.6em;
    font-weight: 600;
  }
  .toc-desktop { display: none; }
  .toc-mobile {
    margin: var(--space-3) 0;
    padding: 0.6em 1em;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg-elevated);
  }
  .toc-mobile > summary {
    cursor: pointer;
    font-weight: 600;
    font-size: var(--fs-small);
  }
  .toc-mobile[open] > summary { margin-bottom: 0.6em; }

  @media (min-width: 1100px) {
    .toc-mobile { display: none; }
    .toc-desktop {
      display: block;
      position: sticky;
      top: var(--space-4);
      max-height: calc(100vh - var(--space-5));
      overflow-y: auto;
    }
  }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length) {
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((a) => {
      const id = a.getAttribute('href')?.slice(1);
      if (id) map.set(id, a);
    });
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((a) => a.classList.remove('active'));
            map.get(e.target.id)?.classList.add('active');
          }
        });
      },
      { rootMargin: '0% 0% -70% 0%', threshold: 0 },
    );
    map.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }
</script>
