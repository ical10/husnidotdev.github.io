---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPosts, postPath } from '../lib/posts';
import { formatDate, isoDate } from '../lib/format';

const posts = await getAllPosts();
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  const list = byYear.get(y) ?? [];
  list.push(p);
  byYear.set(y, list);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---
<BaseLayout title="Archive">
  <div class="container">
    <h1>Archive</h1>
    {years.map(([year, list]) => (
      <section class="year">
        <h2>{year}</h2>
        <ol>
          {list.map((post) => (
            <li>
              <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
              <a href={postPath(post)}>{post.data.title}</a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  h1 { font-family: var(--font-sans); font-size: var(--fs-h1); margin-top: 0; }
  .year { margin-block: var(--space-4); }
  .year h2 {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    color: var(--text-subtle);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.3em;
    margin: 0 0 var(--space-2);
  }
  ol { list-style: none; padding: 0; margin: 0; font-family: var(--font-sans); }
  li {
    display: grid;
    grid-template-columns: 8em 1fr;
    gap: var(--space-2);
    padding: 0.5em 0;
    align-items: baseline;
  }
  li time { font-size: var(--fs-small); color: var(--text-subtle); font-variant-numeric: tabular-nums; }
  li a { color: var(--text); text-decoration: none; }
  li a:hover { color: var(--accent); }
  @media (max-width: 540px) {
    li { grid-template-columns: 1fr; gap: 0; }
  }
</style>
