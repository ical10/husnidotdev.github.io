---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not found">
  <div class="container fourohfour">
    <p class="big">404</p>
    <h1>Lost in the trustless future.</h1>
    <p class="muted">
      The page you're looking for doesn't exist (or moved when I wasn't looking).
    </p>
    <p><a href="/">← Back to the homepage</a></p>
  </div>
</BaseLayout>

<style>
  .fourohfour { text-align: center; padding-block: var(--space-5); }
  .big {
    font-family: var(--font-mono);
    font-size: 5rem;
    margin: 0;
    color: var(--text-subtle);
    line-height: 1;
  }
  h1 { font-family: var(--font-sans); font-size: var(--fs-h2); margin: var(--space-2) 0; }
</style>
